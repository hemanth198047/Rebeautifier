# Enforce LF for shell scripts so Docker builds work after Windows checkouts.
* text=auto eol=lf

*.sh text eol=lf
mvnw text eol=lf
mvnw.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
