# Copy to .env and adjust as needed. Compose reads these automatically.

# API
API_PORT=8080
APP_VERSION=0.7.0
SEED_DEMO_DATA=true
# SPRING_PROFILES_ACTIVE=prod
# SESSION_COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Database (also used by the Postgres container)
POSTGRES_PASSWORD=rebeautifier

# Rate limits
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=20

# Ollama (optional; enable with: docker compose --profile ai up --build)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_MAX_CONCURRENT=1
